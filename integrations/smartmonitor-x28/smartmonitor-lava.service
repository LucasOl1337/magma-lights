[Unit]
Description=SmartMonitor X28 live MAGMA dashboard
StartLimitIntervalSec=60
StartLimitBurst=4

[Service]
Type=simple
ExecStart=/usr/bin/python3 "%h/.local/share/smartmonitor-x28/lava/stats.py"
WorkingDirectory=%h/.local/share/smartmonitor-x28/lava
Restart=on-failure
RestartSec=5
TimeoutStopSec=6
